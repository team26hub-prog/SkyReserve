# Copy to .env and enter your own database credentials.
# Values are literal. Quotes may wrap values containing spaces or # characters.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=airplane_ticketing
DB_USERNAME=your_database_user
DB_PASSWORD="your_database_password"

# Airline payment details shown to customers. Set real details locally in .env.
PAYMENT_BANK_NAME="SkyReserve Demo Bank"
PAYMENT_ACCOUNT_NAME="SkyReserve Coursework Demo"
PAYMENT_ACCOUNT_NUMBER="DEMO-ONLY-000123"
PAYMENT_INSTRUCTIONS="Sample airline payment details for coursework only. Use a sample payment reference and include your booking reference. Submit the details for manual review."
